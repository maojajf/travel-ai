.page-shell-scroll {
  padding: 0;
  height: 100vh;
}

.custom-nav {
  position: sticky;
  top: 0;
  z-index: 120;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding-right: 32rpx;
  padding-left: 32rpx;
  background: rgba(247, 255, 253, 0.96);
  backdrop-filter: blur(12px);
}

.custom-nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #173936;
}

.custom-nav-back {
  position: absolute;
  left: 20rpx;
  bottom: 0;
  display: inline-flex;
  align-items: center;
  height: 44px;
  padding: 0 10rpx;
  background: transparent;
  border: none;
}

.custom-nav-back::after {
  border: none;
}

.custom-nav-back-icon,
.custom-nav-back-text {
  font-size: 28rpx;
  color: #173936;
  line-height: 1;
}

.custom-nav-back-text {
  margin-left: 8rpx;
}

.doc-scroll {
  height: calc(100vh - 64px);
}

.doc-scroll-content {
  padding: 24rpx 24rpx 280rpx;
}

.route-status-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.markdown-render-card,
.stream-notice-card {
  margin-top: 18rpx;
  padding: 28rpx 26rpx;
}

.stream-notice-row {
  display: flex;
  align-items: center;
}

.stream-notice-copy {
  flex: 1;
  margin-left: 18rpx;
}

.stream-notice-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1e4743;
}

.stream-notice-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #73918d;
}

.doc-header-side {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mini-spinner {
  width: 26rpx;
  height: 26rpx;
  border-radius: 999rpx;
  border: 4rpx solid rgba(95, 183, 255, 0.18);
  border-top-color: #53b3ff;
  border-right-color: #2f9e8f;
  animation: doc-spin 0.9s linear infinite;
}

.mini-spinner.subtle {
  width: 22rpx;
  height: 22rpx;
  border-width: 3rpx;
}

.loading-spinner.mini {
  width: 52rpx;
  height: 52rpx;
  margin: 0;
  border-width: 6rpx;
}

.scroll-anchor {
  height: 1px;
}

.provider-footer {
  padding: 20rpx 0 10rpx;
  text-align: center;
}

.provider-footer-text {
  font-size: 22rpx;
  line-height: 1.6;
  color: #b3bebc;
}

.dialog-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background:
    radial-gradient(circle at top, rgba(125, 211, 199, 0.16), transparent 38%),
    rgba(19, 30, 28, 0.38);
}

.dialog-card {
  width: 100%;
  max-width: 620rpx;
  padding: 34rpx 34rpx 30rpx;
  border-radius: 32rpx;
  background:
    linear-gradient(180deg, rgba(249, 255, 253, 0.99) 0%, rgba(255, 255, 255, 0.98) 100%);
  box-shadow: 0 24rpx 64rpx rgba(20, 44, 40, 0.18);
}

.dialog-badge-row {
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialog-badge-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffb86c 0%, #ff8f5a 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 24rpx rgba(255, 143, 90, 0.24);
}

.dialog-badge-text {
  margin-left: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #b56a1e;
  letter-spacing: 1rpx;
}

.dialog-copy {
  margin-top: 24rpx;
  padding: 8rpx 4rpx 0;
}

.dialog-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.45;
  color: #173936;
  text-align: center;
}

.dialog-subtitle {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.75;
  color: #97a4a1;
  text-align: center;
}

.dialog-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 34rpx;
}

.dialog-button {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  border-radius: 22rpx;
}
