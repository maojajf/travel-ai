.tag-wrap {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.list-footer {
  padding: 24rpx 0 8rpx;
  text-align: center;
}

.list-footer-text {
  font-size: 22rpx;
  color: #b3bebc;
}

.empty-card {
  margin-top: 24rpx;
  padding: 44rpx 32rpx 40rpx;
  text-align: center;
}

.favorite-empty-card {
  padding: 52rpx 36rpx 46rpx;
}

.empty-illustration {
  position: relative;
  width: 136rpx;
  height: 136rpx;
  margin: 0 auto 24rpx;
}

.empty-illustration-ring {
  position: absolute;
  inset: 0;
  border-radius: 999rpx;
  background: radial-gradient(circle at 30% 30%, rgba(255, 215, 168, 0.34), rgba(255, 215, 168, 0.08) 62%, rgba(255, 215, 168, 0) 72%);
  border: 2rpx solid rgba(201, 156, 132, 0.12);
}

.empty-illustration-dot {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 34rpx;
  height: 34rpx;
  margin-left: -17rpx;
  margin-top: -17rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffb86c 0%, #df7c43 100%);
  box-shadow: 0 12rpx 24rpx rgba(223, 124, 67, 0.18);
}

.favorite-empty-card .empty-title {
  font-size: 34rpx;
}

.favorite-empty-card .empty-desc {
  max-width: 520rpx;
  margin-left: auto;
  margin-right: auto;
  margin-top: 16rpx;
  line-height: 1.8;
}
