<view class="page-shell">
  <view class="card list-card">
    <text class="section-title">历史路线</text>
    <text class="section-subtitle">这里展示当前设备生成过的路线记录，点击即可查看完整详情。</text>
  </view>

  <block wx:if="{{list.length}}">
    <block wx:for="{{list}}" wx:key="routeId">
      <view class="card list-card" data-id="{{item.routeId}}" bindtap="openDetail">
        <text class="list-title">{{item.city}}</text>
        <text class="list-meta">{{item.startAt}} 至 {{item.endAt}}</text>
        <view class="tag-wrap">
          <text class="tag-chip spot">{{item.travelGroup}}</text>
          <text class="tag-chip food">{{item.budgetLevel}}</text>
          <text class="tag-chip {{item.favorite ? 'tip' : 'transport'}}">{{item.favorite ? '已收藏' : '未收藏'}}</text>
        </view>
        <text class="list-summary">{{item.summary}}</text>
      </view>
    </block>

    <view class="list-footer" wx:if="{{loadingMore}}">
      <text class="list-footer-text">加载中...</text>
    </view>
    <view class="list-footer" wx:if="{{loadFinished}}">
      <text class="list-footer-text">---已到底部---</text>
    </view>
  </block>

  <view wx:else class="card empty-card history-empty-card">
    <view class="empty-illustration">
      <view class="empty-illustration-ring"></view>
      <view class="empty-illustration-dot"></view>
    </view>
    <text class="empty-title">还没有历史路线</text>
    <text class="empty-desc">路线生成完成后这里会自动展示你的历史记录。</text>
  </view>
</view>
